#!/usr/bin/env bash
# shellcheck disable=SC1091
#
# Format staged files.

set -e
set -u
set -o pipefail

. "tools/ci/general.sh"

if ! command -v "nix" &>/dev/null; then
    ci::print_warning "Nix not installed, aborting." >&2
    exit 0
fi

if ! command -v "just" &>/dev/null; then
    ci::print_warning "Tool 'just' is not on your path." >&2
    exit 0
fi

# Use backward compatible syntax to store lines in array
# (readarray not available in some bash version)
FILES=()
while IFS= read -r line
do
    FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR)

# shellcheck disable=SC2128
if [ "${#FILES[@]}" = "0" ]; then
    ci::print_info "No files to format."
    exit 0
fi

just format --fail-on-change "${FILES[@]}" || {
    echo "Formatting changed files: review, 'git add' them, and commit again." >&2
    exit 1
}
